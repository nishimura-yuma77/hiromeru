# Docker Compose has its own defaults. Use these values when running services
# directly on the host.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
DATABASE_URL_UNPOOLED=postgresql+psycopg://app:app@localhost:5432/app
FASTAPI_URL=http://localhost:8000

# 認証Cookie・CSRFトークンの署名鍵（32文字以上）。本番・プレビューでは必須。
# 例: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ローカルでは未設定でも開発用の既定値で動く。
SESSION_SECRET=
# ローカル（HTTP）では false。本番・プレビューでは true（既定）。
COOKIE_SECURE=false
# 本番のOrigin許可リスト（カンマ区切り）。ローカルの既定は http://localhost:3000。
ALLOWED_ORIGINS=http://localhost:3000

# Embedding（OrcaRouter）。フェーズ1の施策・投稿の保存に必要。
ORCAROUTER_BASE_URL=
ORCAROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small

# X API。投稿はユーザーコンテキストのアクセストークンで行う。
X_ACCESS_TOKEN=
