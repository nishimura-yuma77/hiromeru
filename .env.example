# Docker Compose has its own defaults. Use these values when running services
# directly on the host.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
DATABASE_URL_UNPOOLED=postgresql+psycopg://app:app@localhost:5432/app
FASTAPI_URL=http://localhost:8000

# 認証Cookie・CSRFトークンの署名鍵（32文字以上）。本番・プレビューでは必須。
# 例: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ローカルでは未設定でも開発用の既定値で動く。
AUTH_COOKIE_SECRET=
# ローカル（HTTP）では false。本番・プレビューでは true（既定）。
COOKIE_SECURE=false
# 本番のOrigin許可リスト（カンマ区切り）。ローカルの既定は http://localhost:3000。
ALLOWED_ORIGINS=http://localhost:3000

# ローカル開発はfake。本番・プレビューではrealだけを許可する。
EXTERNAL_CLIENT_MODE=fake

# Embedding（OrcaRouter）。realでは必須。
ORCAROUTER_BASE_URL=
ORCAROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small

# Web検索Provider。realでは必須。web_fetchは任意URLを受け取らず検索結果だけを取得する。
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_BYTES=1000000
WEB_FETCH_MAX_REDIRECTS=5

# X API OAuth 1.0a User Context。realでは4項目すべて必須。
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# GA4 Data API。realでは必須。
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# Production Cron。CRON_SECRETはProductionで必須。
CRON_SECRET=
CRON_METRIC_BATCH_SIZE=20
CRON_METRIC_MAX_ITEMS=100
CRON_METRIC_MAX_ATTEMPTS=3
CRON_MEMORY_BATCH_SIZE=20
CRON_MEMORY_MAX_ITEMS=100
CRON_MEMORY_MAX_ATTEMPTS=3

# Vercelの最大実行時間300秒より長くする。
LEASE_SECONDS=330
# Request全体の上限。Vercelの最大実行時間300秒以下にする。
REQUEST_TIMEOUT_SECONDS=300
# 親Turnごとの子Agent呼出上限と、子Agent最終JSONのUTF-8 byte上限。
AGENT_SUBAGENT_MAX_PER_TURN=3
SUBAGENT_FINAL_OUTPUT_MAX_BYTES=64000
