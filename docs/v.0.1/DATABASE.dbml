    content_hash
  }

  Note: '公開済み投稿の意味検索に使用する1対1の検索Projection。EmbeddingはXへの投稿前に生成し、X投稿成功後にposts、post_tracking_links、post_metricsと同じDBトランザクションで保存する。公開済み投稿本文はMVPでは更新しない。'
}

Ref: post_embeddings.post_id > posts.id [delete: cascade]

Table post_tracking_links {
  id bigint [pk, increment, note: '【トラッキングリンクID】']
  post_id bigint [not null, unique, note: '【投稿ID】']
  landing_url text [not null, note: '【遷移先URL】']
  utm_source varchar(255) [not null, default: 'x', note: '【UTM流入元】現状x固定']
  utm_medium varchar(255) [not null, default: 'social', note: '【UTMメディア】現状social固定']
  utm_campaign varchar(255) [not null, note: '【UTMキャンペーン】campaignの一意の識別子']
  utm_content varchar(255) [not null, note: '【UTMコンテンツ】publish_x_postのIdempotency-Key（UUID）。UTM付きURLはX投稿前に確定する必要があり、その時点ではpost_idが存在しないため、承認操作ごとの一意なキーを使用する。']
  tracked_url text [not null, note: '【トラッキングURL】UTMパラメータを付与した遷移先URL。']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']
  updated_at timestamptz [not null, default: `now()`, note: '【更新日時】']

  indexes {
    (utm_source, utm_medium, utm_campaign, utm_content) [unique]
  }

  Note: 'UTM生成は決定論的なアプリケーションロジックとし、LLMを呼び出さない。'
}

Ref: post_tracking_links.post_id > posts.id [delete: cascade]

Table post_metrics {
  post_id bigint [pk, note: '【投稿ID】']
  scheduled_at timestamptz [not null, note: '【計測予定日時】公開から7日後に初週計測を予定する。']
  status post_metric_status [not null, default: 'pending', note: '【計測ステータス】']
  x_pv_count bigint [note: '【X投稿PV数】初週の表示回数。0以上とする。']
  landing_user_count bigint [note: '【遷移ユーザー数】この投稿からアプリケーションページへ到達したユーザー数。0以上とする。']
  measured_at timestamptz [note: '【計測日時】']
  execution_token uuid [note: '【Cron実行Token】ClaimしたWorkerだけが結果を保存するためのFencing Token。']
  lease_expires_at timestamptz [note: '【Cron実行権期限】期限切れ後は別Workerが再Claimできる。']
  attempt_count integer [not null, default: 0, note: '【指標取得試行回数】Claim時に増やす。最大回数のClaimが中断した行はLease切れ後にfailedへ確定する。']
  next_attempt_at timestamptz [note: '【指標取得再試行日時】NULLまたは現在以前なら対象にできる。']
  last_error_code varchar(255) [note: '【指標取得内部Error Code】外部APIの本文とCredentialは保存しない。']
  memory_generated_at timestamptz [note: '【評価記憶生成日時】記憶が後から削除されても残し、再生成を防ぐ。']
  memory_failed_at timestamptz [note: '【評価記憶生成失敗確定日時】最大試行回数へ到達し、自動再試行を停止した日時。']
  memory_attempt_count integer [not null, default: 0, note: '【評価記憶生成試行回数】Claim時に増やす。最大回数のClaimが中断した行はLease切れ後に自動再試行を停止する。']
  memory_next_attempt_at timestamptz [note: '【評価記憶再試行日時】']
  memory_last_error_code varchar(255) [note: '【評価記憶内部Error Code】']

  indexes {
    (status, next_attempt_at, scheduled_at)
    (memory_generated_at, memory_failed_at, memory_next_attempt_at)
  }

  Note: '投稿IDを主キーとして計測処理を冪等にする。Cronはexecution_tokenとlease_expires_atで実行権を制御し、XまたはGA4の部分成功値を保持してNULLのProviderだけを再試行する。v0.1ではfailedをpendingへ戻さない。計測ステータスがcompletedの場合は、両方の計測値と計測日時を必須とする。failedでは取得済みの部分値を保持してよいが、Browser向けAPIへは返さない。評価記憶はmemory_generated_atとmemory_failed_atがどちらもNULLの場合だけ生成し、利用者が記憶を削除しても再生成しない。すべてのtimestamptzはUTCとして保存する。'
}

Ref: post_metrics.post_id > posts.id [delete: restrict]

Table api_list_snapshots {
  id uuid [pk, note: '【一覧Snapshot ID】サーバーが生成し、不透明Cursorへ含める。']
  user_id bigint [not null, note: '【ユーザーID】Snapshotを作成した認証主体。']
  resource varchar(50) [not null, note: '【一覧種別】postsまたはmetrics。']
  filter_hash varchar(64) [not null, note: '【条件Hash】正規化したFilterとSortのSHA-256。']
  summary jsonb [note: '【Snapshot Summary】metricsの期間全体集計。postsではNULL。']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']
  expires_at timestamptz [not null, note: '【有効期限】作成から30分。']

  indexes {
    (user_id, resource, expires_at)
    expires_at
  }

  Note: '可変な計測値で並べる一覧をPage間で固定する短期Snapshot。期限切れ後のCursorはINVALID_ARGUMENTとし、Browser向けResponseへSnapshot IDを直接返さない。'
}

Ref: api_list_snapshots.user_id > users.id [delete: cascade]

Table api_list_snapshot_items {
  snapshot_id uuid [not null, note: '【一覧Snapshot ID】']
  position integer [not null, note: '【表示位置】0始まり。']
  item jsonb [not null, note: '【固定Projection】対象Endpointの1要素を保存する。']

  indexes {
    (snapshot_id, position) [pk]
  }

  Note: '先頭Pageと同じTransactionで確定した順序と表示値を保持する。元データが更新されても有効期限内の続きPageはこのProjectionを返す。'
}

Ref: api_list_snapshot_items.snapshot_id > api_list_snapshots.id [delete: cascade]


