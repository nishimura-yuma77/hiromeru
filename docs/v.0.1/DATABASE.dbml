Project hiromeru {
  database_type: 'PostgreSQL'
  Note: '''
    AI支援型XマーケティングシステムのMVPデータベーススキーマ。

    PostgreSQL拡張:
    - vector: 長期記憶の埋め込みベクトル

    DBMLでは完全に表現できないアプリケーション不変条件:
    - 承認済みの施策または投稿を編集すると改訂番号が増加し、再承認が必要になる。
    - 会社は業務データを所有し、マーケターはそのデータを操作する主体となる。
    - 施策に紐づく投稿は同じ会社に所属しなければならない。
    - 業務データを操作するマーケターは、そのデータを所有する会社に所属しなければならない。
    - 記憶と、それに紐づく施策または投稿は同じ会社に所属しなければならない。
    - 記憶の埋め込みベクトルは、単一設定されたモデルと次元数を使用して記憶内容から生成する。
    - 投稿計測、エージェントターン、エージェントアイテム、ツール実行、LLM呼び出しなどの子レコードは、必須の親レコードから会社所有権を継承する。
    - Xへ公開できるのは承認済み改訂の投稿だけとする。
    - エージェントが生成した施策案は人間が承認するまでエージェント履歴に保持し、承認後に業務データとして保存する。
    - 公開済み投稿と完了済み監査記録は通常のCRUD操作で削除してはならない。
    - エージェントセッションは順序付けられたターンを持ち、各ターンは順序付けられたアイテムを持つ。アイテムはセッションを直接参照しない。
    - エージェントアイテムの内容は追記後に変更しない。コンテキスト状態のみactiveからquarantinedへ変更できる。
    - LLMへ渡す有効なコンテキストは、activeなアイテムではcontent、quarantinedなアイテムではcontext_overrideを使用する。機密値は保存前にマスクする。
    - 生の推論内容と非公開のChain of Thoughtはエージェントアイテムへ保存しない。
    - サブエージェントはツールとして呼び出す。再開可能なタスクIDはTool CallとTool Resultの内容へ保存し、parent_session_idでセッション階層を保持する。
    - コンテキストチェックポイントは完了済みターンの境界でのみ作成する。再構築時は最新の有効なチェックポイントと、それより後のターンを使用する。
    - アイテムを隔離した場合、そのアイテムを要約範囲に含むすべてのチェックポイントを無効化する。
    - ターンが終端状態になった時点で書き込みを終了し、それ以降はアイテム、そのTool Callに対するツール実行、LLM呼び出しを追加しない。
    - ターンのステップ上限とコスト上限はアプリケーション設定とする。使用回数とコストは関連するLLM呼び出しから算出し、上限到達による終了はターンのエラーコードへ記録する。
    - 各ツール実行は1つのtool_callアイテムに所属し、各tool_resultアイテムは同じターンのtool_callアイテムを参照する。
    - 外部コンテンツはGuardrail検査を通過した後もuntrusted_dataとして扱う。
    - セキュリティイベントは監査記録専用とし、コンテキストへ含めるかどうかの正本はエージェントアイテムのコンテキスト状態とする。
    - セキュリティイベントには観測または制御が必要な検出結果だけを記録し、成功したGuardrail検査とAgent Firewall検査は重複記録しない。
    - JSONB内容スキーマとツール固有の入出力スキーマは、保存前にアプリケーションで検証する。
    - 記憶を忘却する場合は、その内容と埋め込みベクトルを完全に削除する。
    - Noteに記載したCHECK制約はSQL migrationで追加する。
  '''
}

Enum user_status {
  active
  disabled
}

Enum campaign_status {
  draft
  pending_approval
  approved
  rejected
  archived
}

Enum post_status {
  draft
  pending_approval
  approved
  publishing
  published
  publish_failed
  archived
}

Enum post_metric_status {
  pending
  processing
  completed
  failed
}

Enum post_metric_failure_source {
  x
  ga4
  system
}

Enum agent_type {
  parent
  campaign_planner
  content_creator
}

Enum agent_session_status {
  active
  archived
}

Enum agent_item_type {
  user_message
  assistant_message
  tool_call
  tool_result
}

Enum agent_item_context_status {
  active
  quarantined
}

Enum agent_context_class {
  conversation
  untrusted_data
}

Enum agent_content_source {
  user_input
  user_document
  agent_output
  web_content
  web_search
  database
  long_term_memory
  external_api
  mcp_tool
  system
}

Enum agent_turn_status {
  pending
  running
  completed
  failed
  cancelled
  blocked
}

Enum tool_execution_status {
  pending
  running
  waiting_for_approval
  completed
  failed
  cancelled
  blocked
}

Enum security_event_type {
  prompt_injection
  sensitive_data
  unauthorized_tool_call
  unsafe_external_action
}

Enum security_detector {
  application
  orcarouter_guardrail
  orcarouter_firewall
}

Enum security_enforcement {
  observed
  sanitized
  blocked
}

Table users {
  id bigint [pk, increment, note: '【ユーザーID】']
  email varchar(320) [not null, note: '【メールアドレス】']
  auth_provider varchar(100) [not null, note: '【認証プロバイダー】']
  auth_subject varchar(255) [not null, note: '【認証主体識別子】認証プロバイダーが発行する不変のユーザー識別子。']
  status user_status [not null, default: 'active', note: '【ユーザーステータス】']
  last_signed_in_at timestamptz [note: '【最終サインイン日時】']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']
  updated_at timestamptz [not null, default: `now()`, note: '【更新日時】']

  indexes {
    email [unique]
    (auth_provider, auth_subject) [unique]
  }

  Note: '認証主体だけを管理する。業務操作はマーケターが行う。'
}

Table companies {
  id bigint [pk, increment, note: '【会社ID】']
  name varchar(255) [not null, note: '【会社名】']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']
  updated_at timestamptz [not null, default: `now()`, note: '【更新日時】']

  Note: '施策関連データと業務データの所有主体。'
}

Table marketers {
  id bigint [pk, increment, note: '【マーケターID】']
  user_id bigint [not null, unique, note: '【ユーザーID】']
  company_id bigint [not null, unique, note: '【会社ID】']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']
  updated_at timestamptz [not null, default: `now()`, note: '【更新日時】']

  indexes {
    (id, company_id) [unique]
  }

  Note: '現行機能における業務操作主体。MVPでは各ユーザーと各会社に紐づくマーケタープロファイルは最大1件とする。'
}

Ref: marketers.user_id > users.id [delete: restrict]
Ref: marketers.company_id > companies.id [delete: restrict]

Table campaigns {
  id bigint [pk, increment, note: '【施策ID】']
  company_id bigint [not null, note: '【会社ID】']
  created_by_marketer_id bigint [not null, note: '【作成者マーケターID】']
  title varchar(255) [not null, note: '【施策タイトル】']
  target_profile text [not null, note: '【ターゲット像】施策でリーチする対象者の属性、状況、課題、動機。']
  background text [not null, note: '【実施背景】']
  objective text [not null, note: '【施策目的】']
  plan text [not null, note: '【施策内容】承認済みまたは提案中のマーケティング戦略と実行内容。']
  status campaign_status [not null, default: 'draft', note: '【施策ステータス】']
  revision int [not null, default: 1, note: '【改訂番号】1以上とし、承認対象の内容を変更するたびに増加させる。']
  approved_revision int [note: '【承認済み改訂番号】承認済みステータスでは改訂番号と一致させる。']
  submitted_at timestamptz [note: '【承認申請日時】']
  approved_at timestamptz [note: '【承認日時】']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']
  updated_at timestamptz [not null, default: `now()`, note: '【更新日時】']
  archived_at timestamptz [note: '【アーカイブ日時】']

  indexes {
    (company_id, status)
    (company_id, created_at)
  }
}

Ref: campaigns.company_id > companies.id [delete: restrict]
Ref: campaigns.created_by_marketer_id > marketers.id [delete: restrict]

Table posts {
  id bigint [pk, increment, note: '【投稿ID】']
  company_id bigint [not null, note: '【会社ID】']
  created_by_marketer_id bigint [not null, note: '【作成者マーケターID】']
  campaign_id bigint [not null, note: '【施策ID】']
  body text [not null, note: '【投稿本文】現行のXテキスト文字数規則をアプリケーションで検証する。']
  status post_status [not null, default: 'draft', note: '【投稿ステータス】']
  revision int [not null, default: 1, note: '【改訂番号】1以上とし、本文または遷移先を変更するたびに増加させる。']
  approved_revision int [note: '【承認済み改訂番号】Xへ投稿する前に改訂番号と一致させる。']
  scheduled_at timestamptz [note: '【投稿予定日時】']
  approved_at timestamptz [note: '【承認日時】']
  published_at timestamptz [note: '【投稿日時】']
  x_post_id varchar(255) [unique, note: '【X投稿ID】']
  last_publish_error text [note: '【最終投稿エラー】マスク済みエラーだけを保存し、認証情報とトークンは保存しない。']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']
  updated_at timestamptz [not null, default: `now()`, note: '【更新日時】']
  archived_at timestamptz [note: '【アーカイブ日時】']

  indexes {
    (company_id, status)
    (campaign_id, status)
    (status, scheduled_at)
  }
}

Ref: posts.company_id > companies.id [delete: restrict]
Ref: posts.created_by_marketer_id > marketers.id [delete: restrict]
Ref: posts.campaign_id > campaigns.id [delete: restrict]

Table post_tracking_links {
  id bigint [pk, increment, note: '【トラッキングリンクID】']
  post_id bigint [not null, unique, note: '【投稿ID】']
  landing_url text [not null, note: '【遷移先URL】']
  utm_source varchar(255) [not null, default: 'x', note: '【UTM流入元】']
  utm_medium varchar(255) [not null, default: 'social', note: '【UTMメディア】']
  utm_campaign varchar(255) [not null, note: '【UTMキャンペーン】']
  utm_content varchar(255) [not null, note: '【UTMコンテンツ】']
  utm_term varchar(255) [note: '【UTMキーワード】']
  tracked_url text [not null, note: '【トラッキングURL】UTMパラメータを付与した遷移先URL。']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']
  updated_at timestamptz [not null, default: `now()`, note: '【更新日時】']

  indexes {
    (utm_source, utm_medium, utm_campaign, utm_content)
  }

  Note: 'UTM生成は決定論的なアプリケーションロジックとし、LLMを呼び出さない。'
}

Ref: post_tracking_links.post_id > posts.id [delete: cascade]

Table post_metrics {
  post_id bigint [pk, note: '【投稿ID】']
  scheduled_at timestamptz [not null, note: '【計測予定日時】公開から7日後に初週計測を予定する。']
  status post_metric_status [not null, default: 'pending', note: '【計測ステータス】']
  x_pv_count bigint [note: '【X投稿PV数】初週の表示回数。0以上とする。']
  landing_user_count bigint [note: '【遷移ユーザー数】この投稿からアプリケーションページへ到達したユーザー数。0以上とする。']
  measured_at timestamptz [note: '【計測日時】']

  indexes {
    (status, scheduled_at)
  }

  Note: '投稿IDを主キーとして計測処理を冪等にする。計測ステータスがcompletedの場合は、両方の計測値と計測日時を必須とする。'
}

Ref: post_metrics.post_id > posts.id [delete: restrict]

Table post_metric_failures {
  id bigint [pk, increment, note: '【計測失敗ID】']
  post_id bigint [not null, note: '【投稿ID】']
  source post_metric_failure_source [not null, note: '【失敗発生元】']
  error_code varchar(100) [note: '【エラーコード】']
  error_message text [not null, note: '【エラーメッセージ】マスク済みエラーだけを保存し、認証情報とトークンは保存しない。']
  retryable boolean [not null, note: '【再試行可否】']
  failed_at timestamptz [not null, default: `now()`, note: '【失敗日時】']

  indexes {
    (post_id, failed_at)
    (retryable, failed_at)
  }

  Note: '失敗した計測試行をすべて保持し、この履歴から再試行上限を判定する。'
}

Ref: post_metric_failures.post_id > post_metrics.post_id [delete: cascade]

Table agent_memories {
  id bigint [pk, increment, note: '【エージェント記憶ID】']
  company_id bigint [not null, note: '【会社ID】']
  content text [not null, note: '【記憶内容】']
  embedding vector [not null, note: '【埋め込みベクトル】記憶内容から生成する。単一の埋め込みモデルと次元数を決定後、vector(n)とHNSWコサイン距離インデックスを設定する。']

  indexes {
    company_id
  }

  Note: '会社単位の長期記憶。施策または投稿との関連がなくても保持できる。'
}

Ref: agent_memories.company_id > companies.id [delete: restrict]

Table memory_campaigns {
  memory_id bigint [not null, note: '【エージェント記憶ID】']
  campaign_id bigint [not null, note: '【施策ID】']

  indexes {
    (memory_id, campaign_id) [pk]
    campaign_id
  }
}

Ref: memory_campaigns.memory_id > agent_memories.id [delete: cascade]
Ref: memory_campaigns.campaign_id > campaigns.id [delete: cascade]

Table memory_posts {
  memory_id bigint [not null, note: '【エージェント記憶ID】']
  post_id bigint [not null, note: '【投稿ID】']

  indexes {
    (memory_id, post_id) [pk]
    post_id
  }
}

Ref: memory_posts.memory_id > agent_memories.id [delete: cascade]
Ref: memory_posts.post_id > posts.id [delete: cascade]

Table agent_sessions {
  id bigint [pk, increment, note: '【エージェントセッションID】']
  company_id bigint [not null, note: '【会社ID】']
  marketer_id bigint [not null, note: '【マーケターID】']
  parent_session_id bigint [note: '【親エージェントセッションID】サブエージェントを呼び出したセッション。']
  agent agent_type [not null, note: '【エージェント種別】']
  title varchar(255) [note: '【セッションタイトル】']
  status agent_session_status [not null, default: 'active', note: '【セッションステータス】']
  next_turn_number int [not null, default: 1, note: '【次回ターン番号】セッション行をロックして原子的に採番する。1以上とする。']
  archived_at timestamptz [note: '【アーカイブ日時】']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']
  updated_at timestamptz [not null, default: `now()`, note: '【更新日時】']

  indexes {
    (id, company_id, marketer_id) [unique]
    (company_id, updated_at)
    (marketer_id, updated_at)
    (parent_session_id, created_at)
    (status, updated_at)
  }

  Note: '1つのエージェントが所有する再開可能な会話。サブエージェントにはparent_session_idで親と紐づく個別セッションを割り当てる。タスク完了はセッション完了ではなくターンで表現する。'
}

Ref: agent_sessions.company_id > companies.id [delete: restrict]
Ref: agent_sessions.(marketer_id, company_id) > marketers.(id, company_id) [delete: restrict]
Ref: agent_sessions.(parent_session_id, company_id, marketer_id) > agent_sessions.(id, company_id, marketer_id) [delete: restrict]

Table agent_turns {
  id bigint [pk, increment, note: '【エージェントターンID】']
  session_id bigint [not null, note: '【エージェントセッションID】']
  turn_number int [not null, note: '【ターン番号】セッション内で単調増加させる。1以上とする。']
  status agent_turn_status [not null, default: 'pending', note: '【ターンステータス】']
  next_item_number int [not null, default: 1, note: '【次回アイテム番号】ターン行をロックして原子的に採番する。1以上とする。']
  error_code varchar(100) [note: '【エラーコード】']
  error_message text [note: '【エラーメッセージ】マスク済みエラーだけを保存する。']
  started_at timestamptz [note: '【開始日時】']
  completed_at timestamptz [note: '【完了日時】']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']
  updated_at timestamptz [not null, default: `now()`, note: '【更新日時】']

  indexes {
    (session_id, turn_number) [unique]
    (id, session_id) [unique]
    (session_id, created_at)
    (status, created_at)
  }

  Note: '1つの入力を受けてから、アシスタント回答またはサブエージェントのTool Resultを返すまでのエージェントループ。1ターン内で複数のLLM呼び出しとツール実行を行える。使用回数とコストは関連するLLM呼び出しから算出する。'
}

Ref: agent_turns.session_id > agent_sessions.id [delete: restrict]

Table tool_executions {
  id bigint [pk, increment, note: '【ツール実行ID】']
  tool_call_item_id bigint [not null, unique, note: '【Tool CallアイテムID】実行対象となるtool_callアイテム。']
  status tool_execution_status [not null, default: 'pending', note: '【ツール実行ステータス】']
  attempt_count int [not null, default: 0, note: '【試行回数】論理的なTool Callに対する内部実行回数。0以上とする。']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']
  completed_at timestamptz [note: '【完了日時】']

  Note: '1つの論理的なtool_callアイテムに対する最小限の実行状態。ツール名、Call ID、引数はtool_callの内容へ、出力と最終エラーはtool_resultの内容へ保存する。内部再試行の詳細はアプリケーションログへ記録する。tool_call_item_idの参照先がtool_callであることをアプリケーションで保証する。'
}

Ref: tool_executions.tool_call_item_id > agent_items.id [delete: restrict]

Table llm_calls {
  id bigint [pk, increment, note: '【LLM呼び出しID】']
  agent_turn_id bigint [not null, note: '【エージェントターンID】']
  orcarouter_request_id varchar(255) [unique, note: '【OrcaRouterリクエストID】OrcaRouterから確定済み利用量とコストを取得するために使用する。']
  input_tokens int [note: '【入力トークン数】OrcaRouterのusage.prompt_tokens。0以上とする。']
  output_tokens int [note: '【出力トークン数】OrcaRouterのusage.completion_tokens。0以上とする。']
  cost_usd decimal(18,8) [note: '【利用コスト（USD）】OrcaRouterが返す確定請求額。0以上とし、日本円への換算は表示時だけ行う。']
  response_time_ms int [note: '【応答時間（ミリ秒）】0以上とする。']
  succeeded boolean [not null, note: '【成功可否】']
  error_code varchar(100) [note: '【エラーコード】']
  error_message text [note: '【エラーメッセージ】マスク済みエラーだけを保存する。']
  called_at timestamptz [not null, default: `now()`, note: '【呼び出し日時】']

  indexes {
    (agent_turn_id, called_at)
    (id, agent_turn_id) [unique]
  }

  Note: 'MVPでは単一設定されたモデルを使用する。失敗した呼び出しではトークン数とコストが取得できない場合がある。'
}

Ref: llm_calls.agent_turn_id > agent_turns.id [delete: restrict]

Table agent_items {
  id bigint [pk, increment, note: '【エージェントアイテムID】']
  agent_turn_id bigint [not null, note: '【エージェントターンID】']
  related_tool_call_item_id bigint [note: '【関連Tool CallアイテムID】tool_resultが応答対象とする同一ターン内のtool_callアイテム。']
  llm_call_id bigint [note: '【LLM呼び出しID】このアイテムを生成したLLM呼び出し。']
  item_number int [not null, note: '【アイテム番号】ターン内で単調増加させる。1以上とする。']
  idempotency_key varchar(255) [not null, note: '【冪等性キー】再試行やクラッシュ復旧時の二重保存を防ぐためにアプリケーションが生成する安定したキー。']
  item_type agent_item_type [not null, note: '【アイテム種別】']
  context_class agent_context_class [not null, note: '【コンテキスト分類】取得元に基づいてアプリケーションが分類する。Guardrail検査を通過してもuntrusted_dataをconversationへ昇格させない。']
  content_source agent_content_source [not null, note: '【コンテンツ取得元】']
  context_status agent_item_context_status [not null, default: 'active', note: '【コンテキスト状態】']
  quarantine_reason varchar(100) [note: '【隔離理由】']
  context_override jsonb [note: '【コンテキスト代替内容】隔離済みアイテムでは必須とし、LLMへは元内容ではなくこの安全な代替内容を渡す。']
  quarantined_at timestamptz [note: '【隔離日時】']
  content jsonb [not null, note: '【アイテム内容】変更不可かつマスク済みの内容。Tool Callの入力はtool_call、Tool Resultの出力はtool_resultへ保存する。']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']

  indexes {
    (id, agent_turn_id) [unique]
    (agent_turn_id, item_number) [unique]
    (agent_turn_id, idempotency_key) [unique]
    (related_tool_call_item_id, item_type) [unique]
    llm_call_id
  }

  Note: '1ターン内の順序付き履歴。内容は変更せず、context_statusはactiveからquarantinedへのみ変更できる。tool_resultではrelated_tool_call_item_idを必須とし、他のアイテム種別ではNULLとする。参照先アイテムの種別はtool_callとする。context_statusがquarantinedの場合だけ隔離関連項目とcontext_overrideを必須とするCHECK制約を追加する。'
}

Ref: agent_items.agent_turn_id > agent_turns.id [delete: restrict]
Ref: agent_items.(related_tool_call_item_id, agent_turn_id) > agent_items.(id, agent_turn_id) [delete: restrict]
Ref: agent_items.(llm_call_id, agent_turn_id) > llm_calls.(id, agent_turn_id) [delete: restrict]

Table agent_context_checkpoints {
  id bigint [pk, increment, note: '【コンテキストチェックポイントID】']
  session_id bigint [not null, note: '【エージェントセッションID】']
  compacted_through_turn_id bigint [not null, note: '【要約済み最終ターンID】このターンまでの履歴を要約に含める。']
  summary text [not null, note: '【コンテキスト要約】マスク済みの要約とし、生の推論内容は含めない。']
  invalidated_at timestamptz [note: '【無効化日時】']
  invalidation_reason varchar(100) [note: '【無効化理由】']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']

  indexes {
    (session_id, compacted_through_turn_id)
    (session_id, created_at)
  }

  Note: '参照先ターンの完了後にだけ追加するチェックポイント。元のアイテムは保持し、再開時は最新の有効なチェックポイントと、それより後のターンを使用する。同じターン境界で有効なチェックポイントを最大1件に制限する部分ユニークインデックスをSQL migrationで追加する。'
}

Ref: agent_context_checkpoints.(compacted_through_turn_id, session_id) > agent_turns.(id, session_id) [delete: restrict]

Table security_events {
  id bigint [pk, increment, note: '【セキュリティイベントID】']
  agent_turn_id bigint [not null, note: '【エージェントターンID】']
  agent_item_id bigint [note: '【エージェントアイテムID】検出対象となったアイテム。']
  llm_call_id bigint [note: '【LLM呼び出しID】検出対象となったLLM呼び出し。']
  event_type security_event_type [not null, note: '【セキュリティイベント種別】']
  detector security_detector [not null, note: '【検出主体】']
  source agent_content_source [not null, note: '【検出対象取得元】']
  enforcement security_enforcement [not null, note: '【制御内容】']
  external_event_id varchar(255) [note: '【外部イベントID】OrcaRouterのMatch IDまたはFirewall Event ID。アプリケーション検出時はNULLとする。']
  summary text [not null, note: '【イベント概要】マスク済みの説明だけを保存し、検出した機密値そのものは保存しない。']
  metadata jsonb [not null, default: '{}', note: '【診断メタデータ】許可リストに含まれるマスク済み診断値だけを保存する。']
  detected_at timestamptz [not null, default: `now()`, note: '【検出日時】']

  indexes {
    (event_type, detected_at)
    (detector, external_event_id) [unique]
    agent_turn_id
    agent_item_id
    llm_call_id
  }

  Note: '1ターン内で検出した追記専用の監査記録。ツール関連の検出結果はagent_item_idから対象のtool_callまたはtool_resultを参照する。成功した検査は記録しない。実行時のコンテキスト包含可否はagent_items.context_statusで制御する。複合外部キーにより、任意参照のアイテムとLLM呼び出しを同じターンに制限する。OrcaRouterのステージ、ルール種別、判定結果は生の一致内容を含めず、許可リストに基づくメタデータとして保存する。'
}

Ref: security_events.agent_turn_id > agent_turns.id [delete: restrict]
Ref: security_events.(agent_item_id, agent_turn_id) > agent_items.(id, agent_turn_id) [delete: restrict]
Ref: security_events.(llm_call_id, agent_turn_id) > llm_calls.(id, agent_turn_id) [delete: restrict]
