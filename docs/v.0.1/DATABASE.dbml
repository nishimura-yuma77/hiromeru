Table post_embeddings {
  post_id bigint [pk, note: '【投稿ID】']
  embedding vector(1536) [not null, note: '【投稿埋め込みベクトル】投稿本文からURLを除去して正規化したテキストから生成する。HNSWコサイン距離インデックス（vector_cosine_ops）をSQL migrationで追加する。']
  content_hash varchar(64) [not null, note: '【埋め込み元ハッシュ】URLを除去して正規化した投稿本文のSHA-256。']
  created_at timestamptz [not null, default: `now()`, note: '【作成日時】']

